{
	"name": "pi-searlo",
	"version": "0.1.4",
	"description": "Perplexity-style fresh web data for pi, backed by the Searlo search API",
        "author": {
                "name": "aginies",
                "email": "antoine@ginies.org"
        },
	"type": "module",
        "engines": {
                "node": ">=22.19.0"
        },
        "repository": {
                "type": "git",
                "url": "https://github.com/aginies/pi-searlo"
        },
        "homepage": "https://github.com/aginies/pi-searlo",
	"bugs": {
                "url": "git+https://github.com/aginies/searlo/issues"
        },
	"license": "MIT",
	"keywords": ["pi-package", "pi-extension", "search", "searlo", "web"],
	"pi": {
		"extensions": ["./src/index.ts"]
	},
	"files": [
		"src/client.ts",
		"src/config.ts",
		"src/format.ts",
		"src/index.ts",
		"README.md"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*"
	},
	"scripts": {
		"test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
		"typecheck": "tsc --noEmit",
		"dev": "pi --extension ./src/index.ts"
	},
        "publishConfig": {
                "access": "public"
        },
        "devDependencies": {
                "@types/node": "^22.0.0",
                "tsx": "^4.19.0",
                "typescript": "^5.5.0"
        }
}
